generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Articulo {
  id          Int         @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  proveedores Proveedor[]

  @@map("articulos")
}

model Proveedor {
  id        Int        @id @default(autoincrement())
  nombre    String
  nacional  Boolean?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  articulos Articulo[]

  @@map("proveedores")
}
